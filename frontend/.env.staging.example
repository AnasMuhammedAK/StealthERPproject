# Copy to .env.staging (git-ignored) and fill in the staging project's values.
# Used by `npm run dev:staging` and `npm run db:push:staging` on your laptop.
# The deployed staging site does NOT read this file: set the same two values
# in Vercel → Project → Settings → Environment Variables → Preview.
# Both values are public — Row Level Security enforces access. A new-style
# `sb_publishable_...` key goes in the ANON_KEY variable below. The
# service-role / secret key must NEVER go here or in Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-or-publishable-key
